# Copy to .env.local (ignored by Git) and set POSTGRES_PASSWORD. Never use NEXT_PUBLIC_* for secrets.
# One file feeds the app (Next.js), Drizzle, scripts and Docker Compose (via the npm db:* scripts).

# Local PostgreSQL container (Compose) -- runtime only
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app
POSTGRES_PORT=5432

# Runtime (server only). Expanded by Next.js, Drizzle config, scripts and Compose.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
# Optional direct connection for migration providers that require it.
DATABASE_URL_UNPOOLED=
LOG_LEVEL=info
